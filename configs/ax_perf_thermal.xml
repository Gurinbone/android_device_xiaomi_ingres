<perf-config>
    <atmc>
        <!-- ============================================== -->
        <!-- CPU Scaling Ladder (Status Index 1 to 27)      -->
        <!-- ============================================== -->
        <cpu_levels>
            <!-- [Lvl 1-4] Burst & Peak Performance -->
            <level id="1"  little="0,1785" big="0,2496" prime="0,2995"/>
            <level id="2"  little="0,1785" big="0,2496" prime="0,2841"/>
            <level id="3"  little="0,1785" big="0,2419" prime="0,2726"/>
            <level id="4"  little="0,1785" big="0,2342" prime="0,2630"/>
            
            <!-- [Lvl 5-8] Sustained High Load Thresholds -->
            <level id="5"  little="0,1689" big="0,2227" prime="0,2515"/>
            <level id="6"  little="0,1574" big="0,2112" prime="0,2400"/>
            <level id="7"  little="0,1478" big="0,1996" prime="0,2284"/>
            <level id="8"  little="0,1478" big="0,1881" prime="0,2169"/>
            
            <!-- [Lvl 9-12] Moderate Thermal Mitigation -->
            <level id="9"  little="0,1363" big="0,1766" prime="0,2054"/>
            <level id="10" little="0,1267" big="0,1651" prime="0,1958"/>
            <level id="11" little="0,1171" big="0,1555" prime="0,1843"/>
            <level id="12" little="0,1075" big="0,1440" prime="0,1728"/>
            
            <!-- [Lvl 13-16] Aggressive Thermal Throttling -->
            <level id="13" little="0,960"  big="0,1324" prime="0,1612"/>
            <level id="14" little="0,844"  big="0,1209" prime="0,1497"/>
            <level id="15" little="0,729"  big="0,1113" prime="0,1401"/>
            <level id="16" little="0,614"  big="0,998"  prime="0,1286"/>
            
            <!-- [Lvl 17-20] Heavy Mitigation / Fallback Floors -->
            <level id="17" little="0,518"  big="0,883"  prime="0,1171"/>
            <level id="18" little="0,403"  big="0,768"  prime="0,1056"/>
            <level id="19" little="0,403"  big="0,633"  prime="0,940"/>
            <level id="20" little="0,307"  big="0,633"  prime="0,806"/>
            
            <!-- [Lvl 21-27] Critical T-Junction / FGS / Screen Off -->
            <level id="21" little="0,307"  big="0,633"  prime="0,806"/>
            <level id="22" little="0,307"  big="0,633"  prime="0,806"/>
            <level id="23" little="0,307"  big="0,633"  prime="0,806"/>
            <level id="24" little="0,307"  big="0,633"  prime="0,806"/>
            <level id="25" little="0,307"  big="0,633"  prime="0,806"/>
            <level id="26" little="0,307"  big="0,633"  prime="0,806"/>
            <level id="27" little="0,307"  big="0,633"  prime="0,806"/>
        </cpu_levels>

        <!-- ============================================== -->
        <!-- GPU Scaling Ladder (Status Index 1 to 11)      -->
        <!-- ============================================== -->
        <gpu_levels>
            <level id="1"  min="818" max="818"/>
            <level id="2"  min="791" max="791"/>
            <level id="3"  min="734" max="734"/>
            <level id="4"  min="640" max="640"/>
            <level id="5"  min="599" max="599"/>
            <level id="6"  min="545" max="545"/>
            <level id="7"  min="492" max="492"/>
            <level id="8"  min="421" max="421"/>
            <level id="9"  min="350" max="350"/>
            <level id="10" min="285" max="285"/>
            <level id="11" min="220" max="220"/>
        </gpu_levels>

        <!-- ============================================== -->
        <!-- Scene Configurations                           -->
        <!-- ============================================== -->
        <scenes>
            <scene name="default_scene">
                <level id="5">
                    <action unit="cpu" status="10"/>
                </level>
                <level id="8">
                    <action unit="cpu" status="12"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="14"/>
                    <action unit="dexopt" status="1"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="16"/>
                    <action unit="bg_killer" status="3"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="17"/>
                    <action unit="bg_killer" status="4"/>
                </level>
                <level id="12">
                    <action unit="cpu" status="19"/>
                </level>
                <level id="13">
                     <action unit="cpu" status="20"/>
                </level>
            </scene>

            <scene name="game">
                <level id="5">
                    <action unit="cpu" status="8"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="10"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="17"/>
                </level>
                <level id="11">
                    <action unit="gpu" status="7"/>
                    <action unit="cpu" status="20"/>
                </level>
                <level id="12">
                    <action unit="gpu" status="10"/>
                </level>
            </scene>

            <scene name="heating_fgs">
                <level id="5">
                    <action unit="cpu" status="20"/>
                </level>
                <level id="7">
                    <action unit="cpu" status="22"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="24"/>
                </level>
            </scene>

            <scene name="axcamera_photo_preview">
                <level id="9">
                    <action unit="cpu" status="13"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="16"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="21"/>
                </level>
            </scene>
        </scenes>

        <!-- ============================================== -->
        <!-- App-Specific Thermal & Performance Profiles    -->
        <!-- ============================================== -->
        <apps>
            <!-- 1. Benchmarks: Disable early throttling restrictions -->
            <app pkgs="com.antutu.ABenchMark,com.andromeda.androbench2,com.primatelabs.geekbench5,com.primatelabs.geekbench6,net.kishonti.gfxbench.v50000.corporate">
                <level id="5">
                    <action unit="cpu" status="0"/>
                </level>
                <level id="13">
                    <action unit="cpu" status="17"/> 
                </level>
                <level id="14">
                    <action unit="cpu" status="24"/> 
                </level>
            </app>

            <!-- 3DMark specifics -->
            <app pkgs="com.futuremark.dmandroid.application">
                <level id="5">
                    <action unit="cpu" status="0"/>
                </level>
                <level id="12">
                    <action unit="gpu" status="8"/>
                </level>
                <level id="14">
                    <action unit="gpu" status="10"/>
                </level>
            </app>

            <!-- 2. Heavy Games (AAA / Open-World / Shooters) -->
            <!-- Strategy: Gradual throttle with high conservative floors to prevent frametime spikes -->
            <app pkgs="com.tencent.tmgp.pubgmhd,com.epicgames.fortnite,com.miHoYo.GenshinImpact,com.miHoYo.hkrpg,com.mojang.minecraftpe,com.HoYoverse.hkrpgoversea,com.miHoYo.Yuanshen,com.pubg.imobile,com.activision.callofduty.shooter,com.dts.freefireth,com.dts.freefiremax">
                <level id="5">
                    <!-- Prime: 2284MHz, GPU limit: 640MHz -->
                    <action unit="cpu" status="7"/>  
                    <action unit="gpu" status="4"/>  
                </level>
                <level id="9">
                    <!-- Prime: 2054MHz, GPU limit: 545MHz -->
                    <action unit="cpu" status="9"/>  
                    <action unit="gpu" status="6"/>  
                </level>
                <level id="11">
                    <!-- Critical floor -> Prime: 1728MHz, GPU limit: 421MHz -->
                    <action unit="cpu" status="12"/> 
                    <action unit="gpu" status="8"/>  
                </level>
            </app>

            <!-- 3. MOBA / Casual Competitive (120fps Targets) -->
            <!-- Strategy: Flat & Narrow Throttling. Restrict burst heat early, maintain high sustained floor (Prime > 1.8GHz) to guarantee 100+ fps in late-game -->
            <app pkgs="com.mobile.legends,com.riotgames.league.wildrift,com.garena.game.kgid,com.tencent.ngame.aov,com.levelinfinite.sgameGlobal,jp.pokemon.pokemonunite,com.supercell.brawlstars">
                <level id="5">
                    <!-- Prime: 2169MHz (Delay heat buildup) -->
                    <action unit="cpu" status="8"/>  
                    <!-- GPU: 545MHz -->
                    <action unit="gpu" status="6"/>  
                </level>
                <level id="9">
                    <!-- Prime: 1958MHz -->
                    <action unit="cpu" status="10"/> 
                    <!-- GPU: 421MHz -->
                    <action unit="gpu" status="8"/>  
                </level>
                <level id="11">
                    <!-- Critical floor -> Prime: 1843MHz (Strict bottom-line for 100+ fps) -->
                    <action unit="cpu" status="11"/> 
                    <!-- GPU: 350MHz (Adreno 730 provides sufficient render throughput, shifting TDP to CPU) -->
                    <action unit="gpu" status="9"/>  
                </level>
            </app>

            <!-- 4. Social, Video Calls & Messaging (Including Streaming & Short Videos) -->
            <!-- Strategy: Aggressive throttling to prevent chassis surface heating -->
            <app pkgs="com.instagram.android,com.facebook.katana,com.facebook.orca,com.whatsapp,com.whatsapp.w4b,com.facebook.lite,com.instagram.lite,com.snapchat.android,us.zoom.videomeetings,com.microsoft.teams,com.google.android.apps.meetings,org.telegram.messenger,org.thunderdog.challegram,com.zhiliaoapp.musically,com.ss.android.ugc.trill,com.twitter.android,com.instagram.barcelona,com.discord,com.reddit.frontpage,jp.naver.line.android,com.pinterest,com.google.android.youtube,app.revanced.android.youtube,com.vanced.android.youtube,com.google.android.apps.youtube.music,app.revanced.android.apps.youtube.music,com.netflix.mediaclient,tv.twitch.android.app">
                <level id="4">
                    <action unit="cpu" status="14"/> <!-- Prime: 1497MHz -->
                </level>
                <level id="6">
                    <action unit="cpu" status="16"/> <!-- Prime: 1286MHz -->
                </level>
                <level id="7">
                    <action unit="cpu" status="19"/> <!-- Prime: 940MHz -->
                </level>
            </app>

            <!-- 5. Navigation -->
            <!-- Strategy: Smooth step-down for sustained GPS + Display on-time -->
            <app pkgs="com.google.android.apps.maps,com.waze">
                <level id="7">
                    <action unit="cpu" status="15"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="21"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="22"/>
                </level>
            </app>

            <!-- 6. Video Editors & Content Creation -->
            <!-- Strategy: Dynamic Progressive. MAX state for burst rendering at cool temps, BALANCE for sustained editing, EFFICIENT floor for long sessions -->
            <app pkgs="com.lemon.lvoverseas,com.lemon.lv,com.nexstreaming.app.kinemasterfree,com.frontrow.vlog,com.alightcreative.motion,com.camerasideas.trimmer,com.camerasideas.instashot,com.cyberlink.powerdirector.DRA140225_01,com.wondershare.filmorago,com.quvideo.xiaoying,com.xvideostudio.videoeditor,com.adobe.premiererush.videoeditor,com.canva.editor,com.vita.videoeditor,com.splice.video.editor,com.lightricks.videoleap,com.gopro.smarty,com.avcrbt.funimate,com.shallwaystudio.nodevideo,com.youcut.videoeditor,com.movavi.videoeditor,com.picsart.studio,com.meitu.wink,com.luma_touch.lumafusion,com.darinsoft.vllo,com.vsco.cam,com.prequel.app,com.captions.app,com.kinemaster.app.spring,com.blurrr.app,com.ls.timecut,com.velomingo.app,com.tempo.video.edit,com.yantech.zoomerang,com.mt.mtxx.mtxx,com.bigwinepot.nwdn.international,com.lightcut.videoeditor,com.arashivision.insta360akiko,dji.mimo,org.tezza,com.adobe.lrmobile,com.cyberlink.actiondirector,com.magisto,com.cam001.beatly,com.videoeditorpro.android,com.pandavideocompressor">
                <level id="5">
                    <action unit="cpu" status="5"/>  <!-- Prime: 2515MHz, Gold: 2227MHz -->
                    <action unit="gpu" status="3"/>  <!-- GPU: 734MHz -->
                </level>
                <level id="8">
                    <action unit="cpu" status="9"/>  <!-- Prime: 2054MHz, Gold: 1766MHz -->
                    <action unit="gpu" status="6"/>  <!-- GPU: 545MHz -->
                </level>
                <level id="11">
                    <action unit="cpu" status="12"/> <!-- Prime: 1728MHz, Gold: 1440MHz -->
                    <action unit="gpu" status="8"/>  <!-- GPU: 421MHz -->
                </level>
                <level id="13">
                    <action unit="cpu" status="17"/> <!-- Prime: 1171MHz -->
                    <action unit="gpu" status="10"/> <!-- GPU: 285MHz -->
                </level>
            </app>

            <!-- 7. Cameras (MIUI Camera, GCam, 3rd Party) -->
            <!-- Strategy: Sustained High Floors. ISP generates massive heat, but strict bottom-lines are required to prevent viewfinder lag, ZSL delays, and 4K frame drops. -->
            <app pkgs="com.android.camera,com.miui.camera,com.google.android.GoogleCamera,com.xiaomi.camera,net.sourceforge.opencamera">
                <!-- Cool/Normal state: Cap initial burst to delay ISP thermal throttling -->
                <level id="5">
                    <action unit="cpu" status="7"/>  <!-- Prime: 2284MHz, Gold: 1996MHz -->
                    <action unit="gpu" status="4"/>  <!-- GPU: 640MHz -->
                </level>
                
                <!-- Moderate thermal: Sustained recording/capture state -->
                <level id="9">
                    <action unit="cpu" status="10"/> <!-- Prime: 1958MHz, Gold: 1651MHz -->
                    <action unit="gpu" status="6"/>  <!-- GPU: 545MHz -->
                </level>
                
                <!-- High thermal: Prolonged camera usage -->
                <level id="11">
                    <action unit="cpu" status="12"/> <!-- Prime: 1728MHz, Gold: 1440MHz -->
                    <action unit="gpu" status="8"/>  <!-- GPU: 421MHz -->
                </level>
                
                <!-- Critical thermal: Hard floor. Prime 1.49GHz to prevent processing freezes -->
                <level id="13">
                    <action unit="cpu" status="14"/> <!-- Prime: 1497MHz, Gold: 1209MHz -->
                    <action unit="gpu" status="10"/> <!-- GPU: 285MHz -->
                </level>
            </app>
        </apps>
    </atmc>
</perf-config>
